# BattleGrid MCP API key (format: bg_live_...). Obtain at battlegrid.trade -> Profile -> MCP tab.
# One active key per account; generating a new key revokes the old one.
BATTLEGRID_API_KEY=bg_live_xxx

# Optional override of the remote MCP endpoint (default: https://mcp.battlegrid.trade/mcp)
# BATTLEGRID_MCP_URL=https://mcp.battlegrid.trade/mcp
